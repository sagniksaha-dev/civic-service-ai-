# ==============================================================================
# AI-Powered Civic Service Assistant - Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="AI-Powered Civic Service Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Token
# NOTE: Generate a secure secret in production: `openssl rand -hex 32`
SECRET_KEY="civic_ai_assistant_development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civic_ai_db
POSTGRES_PORT=5432
# Fallback to SQLite if local PostgreSQL is not currently running
DATABASE_URL=sqlite:///./civic_ai.db
# For PostgreSQL use: postgresql+psycopg2://postgres:postgres@localhost:5432/civic_ai_db

# CORS Configuration (JSON-encoded list of allowed origins or comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]

# LLM & AI Provider Settings
LLM_PROVIDER="auto" # Options: "auto", "gemini", "groq", "openai", "retrieval_only"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# RAG & Knowledge Base Paths
VECTOR_STORE_TYPE="chroma" # Options: "chroma", "faiss"
VECTOR_STORE_PATH="data/vector_index"
KNOWLEDGE_BASE_PATH="data/knowledge_base"
STORAGE_PATH="data/storage"

# Document Ingestion Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SIMILARITY_TOP_K=4
